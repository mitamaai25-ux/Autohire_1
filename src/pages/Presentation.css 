.presentation-root {
  padding: 20px;
  max-width: 900px;
  margin: 0 auto;
}

.controls {
  display:flex;
  justify-content:flex-end;
  margin-bottom: 12px;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border: none;
  padding: 10px 14px;
  border-radius: 8px;
  cursor:pointer;
  font-weight:600;
}

.slides-container {
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 6px 18px rgba(17,24,39,0.06);
}


